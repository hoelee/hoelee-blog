---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { isEn } from '../../lib/lang';
import { sortForListing } from '../../lib/sort';
import { SITE } from '../../config';

const posts = sortForListing(await getCollection('posts', isEn));
---

<BaseLayout
  title="Posts — Mr Hoelee"
  description="All posts on Mr Hoelee's blog."
  switchHref="/zh/"
  altLocaleUrl={`${SITE.url}/zh/`}
>
  <h1>Posts</h1>
  {posts.length === 0 ? (
    <p><em>No posts yet.</em></p>
  ) : (
    <PostList posts={posts} />
  )}
</BaseLayout>
